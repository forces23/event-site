# ─── MongoDB Atlas ───────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/quince?retryWrites=true&w=majority

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=quince-uploads

# Public URL for your R2 bucket (enable public access in R2 dashboard)
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# Hostname only (used by next/image remotePatterns)
R2_PUBLIC_HOSTNAME=pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ─── Site URL ────────────────────────────────────────────────────────────────
# Used by generate-qr script to build the /upload QR code link
NEXT_PUBLIC_SITE_URL=https://yourdomain.vercel.app

# ─── Users ───────────────────────────────────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
VIEWER_USERNAME=
VIEWER_PASSWORD=
VIEWER_EMAIL=

# ─── R2 CORS Setup ───────────────────────────────────────────────────────────
# In your Cloudflare R2 bucket settings, add this CORS policy:
# [
#   {
#     "AllowedOrigins": ["https://yourdomain.vercel.app", "http://localhost:3000"],
#     "AllowedMethods": ["PUT"],
#     "AllowedHeaders": ["content-type"]
#   }
# ]
